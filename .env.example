# Port on the host machine to listen for RDP connection attempts (default: 3389)
HONEYPOT_PORT=3389

# Port on the host machine to access the SQLite Web Administration UI (default: 8080)
DB_ADMIN_PORT=8080

# Database file path inside the honeypot container
DATABASE_PATH=/app/data/RdpHoneypotLogs.db

# Path to the static JPG rendered to authenticated users (default: assets/desktop.jpg)
STATIC_JPG_PATH=assets/desktop.jpg

# Automatically drop connections from repeat RDP clients (set to false for testing)
AUTO_BAN_RDP_CLIENTS=true

# Maximum concurrent RDP connections handled simultaneously (default: 64)
MAX_CONCURRENT_CONNECTIONS=64

# AbuseIPDB APIv2 key for automatically reporting banned RDP clients (leave blank to disable)
ABUSEIPDB_API_KEY=

# Enable/disable AbuseIPDB auto-reporting when API key is set (default: true)
ABUSEIPDB_ENABLED=true

# AbuseIPDB report categories (default: 18,15 -> Brute-Force, Hacking)
ABUSEIPDB_CATEGORIES=18,15

# Optional comma-separated list of additional IPs to never report (your home/public IP and private IPs are excluded automatically)
ABUSEIPDB_EXCLUDED_IPS=
